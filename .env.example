# CherryLink MySQL-only development environment. Never commit .env!
NODE_ENV=development
API_PORT=3001
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=cherrylink
MYSQL_PASSWORD=CHANGE_ME
MYSQL_DATABASE=cherrylink
MYSQL_SSL=false
WEB_URL=http://127.0.0.1:5173
CORS_ORIGIN=http://127.0.0.1:5173
VITE_API_URL=http://127.0.0.1:3001

# Private local disk, shared by API and worker; mount a persistent disk/volume in production.
MEDIA_DIR=./var/cherrylink-media
MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:3001
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
MEDIA_SIGNING_KEY=REPLACE_WITH_RANDOM_96_HEX_CHAR_SECRET
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY_BASE64=REPLACE_WITH_BASE64_32_RANDOM_BYTES

# Optional until you connect Meta. Keep publishing disabled until authorized tests pass.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
META_FACEBOOK_CONFIG_ID=
META_INSTAGRAM_CONFIG_ID=
META_FACEBOOK_REDIRECT_URI=http://127.0.0.1:3001/api/connections/facebook/callback
META_INSTAGRAM_REDIRECT_URI=http://127.0.0.1:3001/api/connections/instagram/callback
LIVE_PUBLISHING_ENABLED=false
WORKER_POLL_MS=10000
WORKER_ID=cherrylink-local-1
