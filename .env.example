# Never commit real credentials. API & worker require these server-only variables.
NODE_ENV=development
API_PORT=3001
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SUPABASE_KEY
SUPABASE_STORAGE_BUCKET=cherrylink-media
TOKEN_ENCRYPTION_KEY_BASE64=BASE64_32_RANDOM_BYTES
META_APP_ID=YOUR_META_APP_ID
META_APP_SECRET=YOUR_META_APP_SECRET
META_GRAPH_VERSION=v26.0
META_FACEBOOK_CONFIG_ID=FACEBOOK_BUSINESS_LOGIN_CONFIG_ID
META_INSTAGRAM_CONFIG_ID=INSTAGRAM_UNIFIED_LOGIN_CONFIG_ID
META_FACEBOOK_REDIRECT_URI=http://localhost:3001/api/connections/facebook/callback
META_INSTAGRAM_REDIRECT_URI=http://localhost:3001/api/connections/instagram/callback
WEB_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
# Change to false until a genuine Meta app / connection proof is complete.
LIVE_PUBLISHING_ENABLED=false
WORKER_POLL_MS=10000
WORKER_ID=cherrylink-local-1
# Frontend (Vite only exposes variables prefixed with VITE_)
VITE_API_URL=http://localhost:3001
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
